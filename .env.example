# Stella Mobile — Environment Configuration
# Copy to .env and fill in values

# =============================================================================
# RELEASE SIGNING (for buildAndroidRelease.js)
# =============================================================================
APP_RELEASE_STORE_PASSWORD=your_keystore_password
APP_RELEASE_KEY_PASSWORD=your_key_password

# =============================================================================
# MODEL DOWNLOAD URLS (optional — models can be bundled or downloaded on first run)
# =============================================================================
UPSTREAM_MODEL_URL=https://your-cdn.com/models/upstream/llama-3.2-3b.Q4_K_M.gguf
MBUZAI_MODEL_URL=https://your-cdn.com/models/mbuzai/k2-horizon.Q4_K_M.gguf

# =============================================================================
# LOCAL INFERENCE SETTINGS
# =============================================================================
STELLA_DEFAULT_ENGINE=upstream
STELLA_LOCAL_ONLY=true

# =============================================================================
# API KEYS FOR EXTERNAL SERVICES (Optional - only needed for specific skills)
# =============================================================================

# -----------------------------------------------------------------------------
# OpenWeatherMap API Key (for weather_live skill - alternative to Open-Meteo)
# -----------------------------------------------------------------------------
# 1. Go to https://openweathermap.org/api
# 2. Click "Get API Key" or "Sign Up" (free tier available)
# 3. Create account with email verification
# 4. Go to "API Keys" tab in your dashboard
# 5. Copy your API key
# 6. Free tier: 60 calls/minute, 1,000,000 calls/month
# OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# -----------------------------------------------------------------------------
# NewsAPI Key (for news_headlines skill)
# -----------------------------------------------------------------------------
# 1. Go to https://newsapi.org/register
# 2. Fill in registration form (name, email, password)
# 3. Verify email address
# 4. Log in and go to "My Account" -> "API Key"
# 5. Copy your API key
# 6. Free tier: 100 requests/day, development only
# NEWSAPI_API_KEY=your_newsapi_key_here

# -----------------------------------------------------------------------------
# GitHub Personal Access Token (for github skill - repos, issues, etc.)
# -----------------------------------------------------------------------------
# 1. Go to https://github.com/settings/tokens
# 2. Click "Generate new token (classic)"
# 3. Name: "Stella Mobile"
# 4. Expiration: No expiration (or set as needed)
# 5. Select scopes:
#    - repo (full repository access)
#    - read:user (read user profile)
#    - read:org (read organization)
# 6. Click "Generate token"
# 7. COPY IMMEDIATELY - you won't see it again!
# 8. Free tier: 5,000 requests/hour
# GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# -----------------------------------------------------------------------------
# Unsplash API Key (for image search skill)
# -----------------------------------------------------------------------------
# 1. Go to https://unsplash.com/developers
# 2. Click "Register as a Developer"
# 3. Fill in application details (name: "Stella Mobile")
# 4. Submit for approval (usually instant)
# 5. Go to "Your Applications" -> "Demo" or create new
# 6. Copy "Access Key" (public) and "Secret Key" (private)
# 7. Free tier: 50 requests/hour
# UNSPLASH_ACCESS_KEY=your_unsplash_access_key
# UNSPLASH_SECRET_KEY=your_unsplash_secret_key

# -----------------------------------------------------------------------------
# CoinGecko API Key (for crypto skill - higher rate limits)
# -----------------------------------------------------------------------------
# 1. Go to https://www.coingecko.com/en/api
# 2. Scroll to "CoinGecko API" section
# 3. Click "Get Free API Key" or "Analyst API"
# 4. Register with email
# 5. Free tier: 50 calls/minute (no key) or 500 calls/minute (with key)
# 6. Copy your API key
# COINGECKO_API_KEY=your_coingecko_api_key

# -----------------------------------------------------------------------------
# ExchangeRate-API Key (for currency skill - higher limits)
# -----------------------------------------------------------------------------
# 1. Go to https://www.exchangerate-api.com/
# 2. Click "Get Free API Key"
# 3. Register with email
# 4. Free tier: 1,500 requests/month (no key needed for basic)
# 5. Paid tiers for higher limits
# 6. Copy your API key if upgrading
# EXCHANGERATE_API_KEY=your_exchangerate_api_key

# -----------------------------------------------------------------------------
# Alpha Vantage API Key (for stock prices - alternative)
# -----------------------------------------------------------------------------
# 1. Go to https://www.alphavantage.co/support/#api-key
# 2. Fill in form for free API key
# 3. Receive key instantly on screen and via email
# 4. Free tier: 5 requests/minute, 500 requests/day
# ALPHAVANTAGE_API_KEY=your_alphavantage_api_key

# -----------------------------------------------------------------------------
# Twelve Data API Key (for forex/stocks - alternative)
# -----------------------------------------------------------------------------
# 1. Go to https://twelvedata.com/apikey
# 2. Sign up for free account
# 3. Free tier: 800 requests/day
# TWELVE_DATA_API_KEY=your_twelvedata_api_key

# -----------------------------------------------------------------------------
# FRED API Key (for economic data - Federal Reserve)
# -----------------------------------------------------------------------------
# 1. Go to https://fred.stlouisfed.org/docs/api/api_key.html
# 2. Register for free account
# 3. Request API key
# 4. Free, no rate limits published
# FRED_API_KEY=your_fred_api_key

# -----------------------------------------------------------------------------
# NASA API Key (for space/apod skills)
# -----------------------------------------------------------------------------
# 1. Go to https://api.nasa.gov/
# 2. Click "Generate API Key"
# 3. Fill in name and email
# 4. Receive key instantly
# 5. Free tier: 1,000 requests/hour
# NASA_API_KEY=your_nasa_api_key

# =============================================================================
# FEATURE FLAGS (enable/disable skills requiring API keys)
# =============================================================================
# Set to "true" to enable skills that require API keys
ENABLE_WEATHER_OWM=false
ENABLE_NEWS_HEADLINES=false
ENABLE_GITHUB_INTEGRATION=false
ENABLE_UNSPLASH_IMAGES=false
ENABLE_CRYPTO_PREMIUM=false
ENABLE_STOCK_PRICES=false
# =============================================================================
# CLOUD AI PROVIDER API KEYS (for cloud_provider_api skill)
# =============================================================================

# -----------------------------------------------------------------------------
# Anthropic API Key (Claude models)
# -----------------------------------------------------------------------------
# 1. Go to https://console.anthropic.com/
# 2. Sign up / log in with email or Google/GitHub
# 3. Go to "API Keys" in left sidebar
# 4. Click "Create Key"
# 5. Name: "Stella Mobile"
# 6. Copy key immediately (starts with sk-ant-)
# 7. Free tier: $5 credit on signup, then pay-as-you-go
#    Haiku: $0.25/M in, $1.25/M out
#    Sonnet: $3/M in, $15/M out
#    Opus: $15/M in, $75/M out
# ANTHROPIC_API_KEY=sk-ant-your_key_here

# -----------------------------------------------------------------------------
# Google AI API Key (Gemini models)
# -----------------------------------------------------------------------------
# 1. Go to https://aistudio.google.com/apikey
# 2. Click "Create API Key"
# 3. Select project or create new
# 4. Copy key (starts with AIza)
# 5. Free tier: 15 RPM, 1M tokens/day (Gemini 1.5 Flash)
#    Pro: 2 RPM free, then $1.25/M in, $5/M out
#    Flash: $0.075/M in, $0.30/M out
# GOOGLE_API_KEY=AIza_your_key_here

# -----------------------------------------------------------------------------
# Groq API Key (Ultra-fast LLM inference)
# -----------------------------------------------------------------------------
# 1. Go to https://console.groq.com/keys
# 2. Sign up / log in
# 3. Click "Create API Key"
# 4. Name: "Stella Mobile"
# 5. Copy key (starts with gsk_)
# 6. Free tier: 14,400 req/day, 30 RPM
#    All models including Llama 3.1 70B free
#    Paid: $0.05-0.79/M tokens
# GROQ_API_KEY=gsk_your_key_here

# -----------------------------------------------------------------------------
# OpenRouter API Key (Unified API for 300+ models)
# -----------------------------------------------------------------------------
# 1. Go to https://openrouter.ai/keys
# 2. Sign up / log in
# 3. Click "Create Key"
# 4. Name: "Stella Mobile"
# 5. Copy key (starts with sk-or-)
# 6. Free tier: $1 credit on signup
#    Pay-as-you-go at provider rates + small routing fee
#    Access to free models (various)
# OPENROUTER_API_KEY=sk-or-your_key_here

# -----------------------------------------------------------------------------
# Cline / ClinePass API Key (AI coding assistant)
# -----------------------------------------------------------------------------
# 1. Go to https://cline.bot/
# 2. Sign up for ClinePass
# 3. Go to dashboard -> API Keys
# 4. Generate key
# 5. Free tier: 50 requests/day
#    Pro: $20/mo unlimited cloud requests
#    Local models (Ollama): completely free
# CLINE_API_KEY=your_cline_api_key

# -----------------------------------------------------------------------------
# NVIDIA NIM API Key (Enterprise AI deployment)
# -----------------------------------------------------------------------------
# 1. Go to https://www.nvidia.com/en-us/ai-data-science/products/nim/
# 2. Apply for NIM access / NGC account
# 3. Go to NGC -> Setup -> API Key
# 4. Generate key
# 5. Free: 30-day evaluation, free containers for dev
#    Enterprise: per-GPU subscription
#    Cloud: pay-per-use on DGX Cloud, AWS, Azure, GCP
# NVIDIA_API_KEY=your_nvidia_api_key

# =============================================================================
# FEATURE FLAGS (enable/disable skills requiring API keys)
# =============================================================================
# Set to "true" to enable skills that require API keys
ENABLE_WEATHER_OWM=false
ENABLE_NEWS_HEADLINES=false
ENABLE_GITHUB_INTEGRATION=false
ENABLE_UNSPLASH_IMAGES=false
ENABLE_CRYPTO_PREMIUM=false
ENABLE_STOCK_PRICES=false

# Cloud AI Provider feature flags
ENABLE_ANTHROPIC_CLAUDE=false
ENABLE_GOOGLE_GEMINI=false
ENABLE_GROQ=false
ENABLE_OPENROUTER=false
ENABLE_CLINE=false
ENABLE_NVIDIA_NIM=false

# =============================================================================
# VOICE MODEL SETTINGS
# =============================================================================
# STT Engine: executorch | whisper_rn | os | auto
# TTS Engine: onnx | os | auto
# Model paths (auto-detected if bundled)
# STT_MODEL_PATH=assets/models/whisper_tiny_execorch.pte
# TTS_MODEL_PATH=assets/models/kokoro_82m.onnx