{
  "name": "stella-mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "lint": "oxlint . && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "clean": "cd android && ./gradlew clean",
    "build:android:release": "node scripts/buildAndroidRelease.js",
    "install:models": "ts-node scripts/install-models.ts",
    "install:models:force": "rm -rf assets/models && ts-node scripts/install-models.ts",
    "bundle:models": "ts-node scripts/bundle-models.ts",
    "prepare:production": "npm run install:models && npm run bundle:models"
  },
  "dependencies": {
    "react": "19.1.4",
    "react-native": "0.81.6",
    "llama.rn": "0.12.9",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-keychain/keychain": "^10.0.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/drawer": "^7.13.10",
    "@react-navigation/stack": "^7.1.1",
    "react-native-screens": "~4.24.0",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-gesture-handler": "^2.32.0",
    "react-native-reanimated": "~4.1.7",
    "react-native-sse": "^1.2.1",
    "axios": "^1.8.2",
    "react-native-voice": "^3.2.4",
    "react-native-fs": "^2.20.0",
    "react-native-svg": "^15.11.1",
    "@dr.pogodin/react-native-fs": "^2.40.2",
    "pdf-lib": "^1.17.1",
    "marked": "^5.0.5",
    "react-native-markdown-display": "^7.0.2",
    "nativewind": "^4.2.6",
    "tailwindcss": "^3.4.17",
    "react-native-vector-icons": "^10.1.0",
    "uuid": "^10.0.0",
    "zod": "^3.24.1",
    "date-fns": "^3.6.0",
    "i18next": "^25.10.10",
    "react-i18next": "^15.7.4",
    "expo-crypto": "^13.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.27.1",
    "@react-native/babel-preset": "0.81.6",
    "@react-native/eslint-config": "0.81.6",
    "@react-native/metro-config": "0.81.6",
    "@react-native/typescript-config": "0.81.6",
    "@types/react": "^19.1.4",
    "@types/react-native": "^0.81.6",
    "@types/uuid": "^10.0.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "metro-react-native-babel-preset": "^0.81.6",
    "oxlint": "^0.35.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "packageManager": "npm@12.2.0"
}
